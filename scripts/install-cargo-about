#!/usr/bin/env bash
set -euo pipefail

version=0.9.2
arch=$(uname -m)
case "$arch" in
    x86_64) sum=9099a59e820c38a68b9d65f300662a567d56562f9a10f6aa4c7e86c17c2566af ;;
    aarch64) sum=af5169282fb6f84e13471493f405437e43ac517744c9ae12fbe2cdf0a6f0e5a8 ;;
    *) echo "Unsupported cargo-about architecture: $arch" >&2; exit 1 ;;
esac
name=cargo-about-$version-$arch-unknown-linux-musl
archive=$(mktemp "${RUNNER_TEMP:-${TMPDIR:-/tmp}}/cargo-about.XXXXXX")
trap 'rm -- "$archive"' EXIT
curl -fsSLo "$archive" "https://github.com/EmbarkStudios/cargo-about/releases/download/$version/$name.tar.gz"
echo "$sum  $archive" | sha256sum -c -
install_dir=${CARGO_HOME:-$HOME/.cargo}/bin
mkdir -p "$install_dir"
tar xzf "$archive" -C "$install_dir" --strip-components=1 "$name/cargo-about"
